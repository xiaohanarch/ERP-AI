# ============================================================
# ERP-Demo 环境配置模板（复制为 .env 后按需修改）
# ============================================================

# --- 模型供应商（三层兜底：mock -> replay -> live） ---
# mock  : 脚本化确定性应答（默认，无需任何 key）
# replay: 录制回放（未命中按 REPLAY_MISS_MODE 处理）
# live  : 真实供应商调用
MODEL_MODE=mock
# live 模式供应商（OpenAI 兼容）：deepseek | glm | qwen
LIVE_PROVIDER=deepseek
LIVE_BASE_URL=
LIVE_API_KEY=
LIVE_MODEL=deepseek-chat
# replay 未命中策略：strict=评测用直接失败；passthrough=演示用透传到 mock
REPLAY_MISS_MODE=passthrough

# --- 令牌密钥（演示用固定值；生产必须注入强随机密钥） ---
GW_JWT_SECRET=erp-demo-jwt-secret-0123456789abcdef-0123456789abcdef
HUB_CLIENT_SECRET=erp-demo-hub-client-secret
GW_INTERNAL_SECRET=erp-demo-internal-secret

# --- 数据库 ---
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp-demo-pwd
POSTGRES_DB=erp

# --- 服务地址（compose 网络内） ---
ERP_AP_BASE=http://legacy-erp-ap:8080
GW_BASE=http://ai-gateway:8000
HUB_BASE=http://hub:8001
SEMANTICS_BASE=http://semantics:8002
MODEL_BASE=http://mock-model:8090
JAEGER_OTLP=http://jaeger:4318

# --- 演示初始管理员（网关注册中心管理凭据） ---
GW_ADMIN_USER=admin
GW_ADMIN_PASSWORD=admin-demo-pwd
